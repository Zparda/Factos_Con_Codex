server {
    listen 80;
    listen [::]:80;
    server_name factossolutions.com www.factossolutions.com;

    root /var/www/factos;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|svg|webp|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }
}

